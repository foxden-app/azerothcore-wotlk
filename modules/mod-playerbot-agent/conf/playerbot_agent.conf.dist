#
# Playerbot Agent bridge
#

# Enable the in-game bridge that queues player chat for the Python sidecar
# and executes whitelisted Playerbots instincts from the action queue.
AgentPlayerbot.Enabled = 1

# How often worldserver polls acore_playerbots.agent_playerbot_actions.
AgentPlayerbot.ActionPollIntervalMs = 500

# Soft reply byte limit for bridge-sent bot chat.
# 0 disables bridge-side clipping; prefer prompt/skill guidance for short replies.
# Positive values keep UTF-8 boundaries and append "..." instead of cutting bytes.
AgentPlayerbot.MaxReplyLength = 0

# Emit chat/action trace lines to Server.log under module.playerbot_agent.
AgentPlayerbot.TraceLog = 1

# Runtime context attached to each queued chat event for the Python LLM sidecar.
AgentPlayerbot.ContextRange = 45
AgentPlayerbot.MaxNearbyHostiles = 8

# Aggregate combat facts for real-player + Playerbot groups. Raw damage/heal
# events stay in memory; one compact row is written after combat goes idle.
AgentPlayerbot.CombatTelemetryEnabled = 1
AgentPlayerbot.CombatIdleEndMs = 5000
AgentPlayerbot.CombatMinDurationMs = 3000
AgentPlayerbot.CombatTimelineLimit = 80

# Fixed command-entry bot. The bridge keeps this bot online independently of
# the random bot pool and accepts /say or /yell only when the message names it
# (or one of its aliases). If the bot is too far away for /say visibility, the
# bridge falls back to whisper for that reply.
AgentPlayerbot.AnchorBotAutologin = 1
AgentPlayerbot.AnchorBotName = "瓦小狸"
AgentPlayerbot.AnchorBotAliases = "小狸"
AgentPlayerbot.AnchorBotEnsureIntervalMs = 5000
