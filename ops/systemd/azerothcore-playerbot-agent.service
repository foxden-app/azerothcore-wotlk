[Unit]
Description=AzerothCore PlayerBot Agent Sidecar
After=network-online.target mysql.service azerothcore-world.service
Wants=network-online.target mysql.service azerothcore-world.service

[Service]
Type=simple
User=wuya
Group=wuya
WorkingDirectory=/home/wuya/git/azerothcore-wotlk-git
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/home/wuya/git/azerothcore-wotlk-git/env/dist/etc/playerbot-agent.env
ExecStartPre=/usr/bin/mkdir -p /home/wuya/git/azerothcore-wotlk-git/env/dist/logs /home/wuya/git/azerothcore-wotlk-git/var/playerbot-agent
ExecStart=/usr/bin/python3 /home/wuya/git/azerothcore-wotlk-git/tools/playerbot-agent/agent_bridge.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=append:/home/wuya/git/azerothcore-wotlk-git/env/dist/logs/playerbot-agent.log
StandardError=append:/home/wuya/git/azerothcore-wotlk-git/env/dist/logs/playerbot-agent.log

[Install]
WantedBy=multi-user.target
