# Runtime configuration for azerothcore-playerbot-agent.service.
# Copy to env/dist/etc/playerbot-agent.env and keep real API keys out of git.

PLAYERBOT_AGENT_DB_DSN="127.0.0.1;3306;acore;acore;acore_playerbots"
PLAYERBOT_AGENT_STATE="var/playerbot-agent/state.json"
PLAYERBOT_AGENT_POLL_INTERVAL="1"

# Keep rule mode on until an OPENAI-compatible key is configured.
PLAYERBOT_AGENT_RULE_ONLY="1"

# Trace decisions and enqueued actions. Prompt tracing is noisier.
PLAYERBOT_AGENT_TRACE="1"
PLAYERBOT_AGENT_TRACE_PROMPT="0"
PLAYERBOT_AGENT_TRACE_REASONING="0"
PLAYERBOT_AGENT_TRACE_LLM_RAW="0"
PLAYERBOT_AGENT_COMBAT_MEMORY_LIMIT="3"
PLAYERBOT_AGENT_HISTORY_LIMIT="240"
PLAYERBOT_AGENT_HISTORY_TTL_SECONDS="14400"
PLAYERBOT_AGENT_PROMPT_MESSAGE_LIMIT="40"

# DeepSeek/OpenAI-compatible LLM settings. Enable by setting a key and
# changing PLAYERBOT_AGENT_RULE_ONLY to 0.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com"
PLAYERBOT_AGENT_MODEL="deepseek-v4-flash"
# Accepts enabled/enable or disabled/disable.
PLAYERBOT_AGENT_LLM_THINKING="disabled"
PLAYERBOT_AGENT_LLM_MAX_TOKENS="512"
PLAYERBOT_AGENT_LLM_TIMEOUT="20"
