# Runtime configuration for azerothcore-playerbot-mcp.service.
# Copy to env/dist/etc/playerbot-mcp.env and keep tokens out of git.

PLAYERBOT_MCP_DB_DSN="127.0.0.1;3306;acore;acore;acore_playerbots"
PLAYERBOT_MCP_AUTH_DB_DSN="127.0.0.1;3306;acore;acore;acore_auth"
PLAYERBOT_MCP_HOST="0.0.0.0"
PLAYERBOT_MCP_PORT="18765"
PLAYERBOT_MCP_BEARER_TOKEN=""
PLAYERBOT_MCP_LOG_LEVEL="INFO"
PLAYERBOT_MCP_UVICORN_LOG_LEVEL="info"
PLAYERBOT_AGENT_ANCHOR_BOT_NAME="瓦小狸"
PLAYERBOT_AGENT_ANCHOR_ALIASES="小狸"
# 默认拒绝已处理旧事件继续入队动作，防止 Agent 沿用历史 event_id。
PLAYERBOT_MCP_REJECT_PROCESSED_EVENT_ACTIONS="1"
# 高危工具要求真实发言人的账号 GM 等级达到该阈值；如果配置了名字列表，还必须同时匹配名字。
PLAYERBOT_MCP_ADMIN_GM_LEVEL="3"
PLAYERBOT_MCP_ADMIN_PLAYER_NAMES="Wuya"
