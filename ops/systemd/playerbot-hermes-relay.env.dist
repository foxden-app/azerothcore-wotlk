# Runtime configuration for azerothcore-playerbot-hermes-relay.service.
# Copy to env/dist/etc/playerbot-hermes-relay.env and keep tokens out of git.

PLAYERBOT_HERMES_RELAY_DB_DSN="127.0.0.1;3306;acore;acore;acore_playerbots"
PLAYERBOT_HERMES_RELAY_STATE="var/playerbot-hermes-relay/state.json"
PLAYERBOT_HERMES_URL="http://192.168.1.179:8642/v1/responses"
PLAYERBOT_HERMES_MODEL="hermes-agent"
PLAYERBOT_HERMES_API_KEY=""
PLAYERBOT_HERMES_POLL_INTERVAL="1"
PLAYERBOT_HERMES_POLL_LIMIT="10"
PLAYERBOT_HERMES_TIMEOUT="120"
PLAYERBOT_HERMES_TRACE_RAW="1"
PLAYERBOT_AGENT_ANCHOR_BOT_NAME="瓦小狸"
PLAYERBOT_AGENT_ANCHOR_ALIASES="小狸"
PLAYERBOT_HERMES_IGNORE_UNADDRESSED_SAY="1"
PLAYERBOT_HERMES_IGNORE_QUEST_PROGRESS_CHAT="1"
NO_PROXY="127.0.0.1,localhost,192.168.1.15,192.168.1.179"
