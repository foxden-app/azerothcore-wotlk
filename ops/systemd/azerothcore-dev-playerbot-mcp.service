[Unit]
Description=AzerothCore DEV PlayerBot MCP Tool Server
After=network-online.target mysql.service azerothcore-dev-world.service
Wants=network-online.target mysql.service azerothcore-dev-world.service

[Service]
Type=simple
User=wuya
Group=wuya
WorkingDirectory=/home/wuya/git/azerothcore-wotlk-dev
Environment=PATH=/home/wuya/git/azerothcore-wotlk-dev/var/playerbot-mcp-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/home/wuya/git/azerothcore-wotlk-dev/env/dist/etc/playerbot-mcp-dev.env
ExecStartPre=/usr/bin/mkdir -p /home/wuya/git/azerothcore-wotlk-dev/env/dist/logs
ExecStart=/home/wuya/git/azerothcore-wotlk-dev/var/playerbot-mcp-venv/bin/python /home/wuya/git/azerothcore-wotlk-dev/tools/playerbot-mcp/server.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=append:/home/wuya/git/azerothcore-wotlk-dev/env/dist/logs/playerbot-mcp-dev.log
StandardError=append:/home/wuya/git/azerothcore-wotlk-dev/env/dist/logs/playerbot-mcp-dev.log

[Install]
WantedBy=multi-user.target
