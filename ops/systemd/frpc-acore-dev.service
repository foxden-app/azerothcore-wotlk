[Unit]
Description=FRP Client for GJZN AzerothCore agile dev line
After=network-online.target azerothcore-dev-world.service
Wants=network-online.target

[Service]
Type=simple
User=wuya
Group=wuya
WorkingDirectory=/home/wuya/dev/frp
ExecStart=/home/wuya/dev/frp/frpc -c /home/wuya/dev/frp/frpc-acore-dev.toml
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
