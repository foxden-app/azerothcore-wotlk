[Unit]
Description=Hermes WOW DEV Gateway
After=network-online.target docker.service azerothcore-dev-playerbot-mcp.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/home/wuya/srv/hermes-wow-dev
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
