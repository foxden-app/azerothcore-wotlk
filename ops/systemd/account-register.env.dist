# Runtime configuration for azerothcore-account-register.service.
# Copy to env/dist/etc/account-register.env and keep invite codes/passwords out of git.

# Bind to localhost by default. Put a reverse proxy or SSH tunnel in front when exposing it.
ACCOUNT_REGISTER_HOST="127.0.0.1"
ACCOUNT_REGISTER_PORT="18080"

ACCOUNT_REGISTER_REALM_NAME="Agent PlayerBot"

# Keep this enabled unless the service is only reachable on a trusted private network.
ACCOUNT_REGISTER_REQUIRE_INVITE="1"
ACCOUNT_REGISTER_INVITE_CODE=""

ACCOUNT_REGISTER_RATE_LIMIT_PER_HOUR="12"
ACCOUNT_REGISTER_TRUST_PROXY="0"

# SOAP account creation is delegated to worldserver.
# If ACCOUNT_REGISTER_SOAP_PASSWORD is empty, the service also reads ACORE_GM_PASS
# from ~/.config/acore/gm.env for the service user.
ACCOUNT_REGISTER_SOAP_URL="http://127.0.0.1:7879/"
ACCOUNT_REGISTER_SOAP_USER="SOAP_PANEL"
ACCOUNT_REGISTER_SOAP_PASSWORD=""
ACCOUNT_REGISTER_SOAP_TIMEOUT="20"
