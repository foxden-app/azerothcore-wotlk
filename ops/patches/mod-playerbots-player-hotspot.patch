+void RandomPlayerbotMgr::UpdatePlayerHotspots()
+{
+    if (!sPlayerbotAIConfig.playerHotspotBots || !sPlayerbotAIConfig.randomBotAutologin || !sPlayerbotAIConfig.enabled)
+        return;
+
+    uint32 moved = 0;
+    std::vector<Player*> snapshot = players;
+    for (Player* player : snapshot)
+    {
+        if (!IsHotspotEligiblePlayer(player))
+            continue;
+
+        uint32 nearby = CountHotspotBotsNear(player);
+        if (nearby >= sPlayerbotAIConfig.playerHotspotMinBots)
+            continue;
+
+        uint32 target = urand(sPlayerbotAIConfig.playerHotspotMinBots, sPlayerbotAIConfig.playerHotspotMaxBots);
+        while (nearby < target)
+        {
+            Player* bot = SelectHotspotBot(player);
+            if (!bot || !TeleportBotNearPlayer(bot, player))
+                break;
+
+            ++nearby;
+            ++moved;
+        }
+    }
+
+    if (moved)
+        LOG_DEBUG("playerbots", "Player hotspot teleported {} random bots near active players.", moved);
+}
+
+bool RandomPlayerbotMgr::IsHotspotEligiblePlayer(Player* player)
+{
+    if (!player || !player->IsInWorld() || player->IsBeingTeleported() || !player->GetSession() ||
+        player->GetSession()->IsBot())
+        return false;
+
+    if (player->IsGameMaster() || player->InBattleground() || player->InArena() || player->InBattlegroundQueue() ||
+        player->HasUnitState(UNIT_STATE_IN_FLIGHT) || player->IsFlying())
+        return false;
+
+    Map* map = player->GetMap();
+    if (!map || map->Instanceable() || map->IsBattlegroundOrArena())
+        return false;
+
+    return true;
+}
+
+uint32 RandomPlayerbotMgr::CountHotspotBotsNear(Player* player)
+{
+    if (!IsHotspotEligiblePlayer(player))
+        return 0;
+
+    float radius = static_cast<float>(std::max<uint32>(40, sPlayerbotAIConfig.playerHotspotRadius));
+    uint32 count = 0;
+    for (PlayerBotMap::const_iterator itr = playerBots.begin(); itr != playerBots.end(); ++itr)
+    {
+        Player* bot = itr->second;
+        if (!bot || !IsRandomBot(bot) || !bot->IsInWorld() || bot->IsBeingTeleported() || !bot->IsAlive())
+            continue;
+
+        if (bot->GetTeamId() != player->GetTeamId() || !player->IsInMap(bot))
+            continue;
+
+        if (player->GetDistance(bot) <= radius)
+            ++count;
+    }
+
+    return count;
+}
+
+bool RandomPlayerbotMgr::IsHotspotCandidate(Player* bot, Player* target)
+{
+    if (!bot || !IsRandomBot(bot) || !IsHotspotEligiblePlayer(target))
+        return false;
+
+    if (!bot->IsInWorld() || bot->IsBeingTeleported() || !bot->IsAlive() || bot->IsInCombat() || bot->GetGroup())
+        return false;
+
+    if (bot->InBattleground() || bot->InArena() || bot->InBattlegroundQueue() ||
+        bot->HasUnitState(UNIT_STATE_IN_FLIGHT) || bot->IsFlying())
+        return false;
+
+    if (bot->GetTeamId() != target->GetTeamId())
+        return false;
+
+    int32 levelDiff = static_cast<int32>(bot->GetLevel()) - static_cast<int32>(target->GetLevel());
+    if (levelDiff < -8 || levelDiff > 8)
+        return false;
+
+    uint32 botId = bot->GetGUID().GetCounter();
+    if (GetEventValue(botId, "player_hotspot"))
+        return false;
+
+    if (target->IsInMap(bot) && target->GetDistance(bot) <= static_cast<float>(sPlayerbotAIConfig.playerHotspotRadius))
+        return false;
+
+    if (PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot))
+    {
+        if (botAI->HasPlayerNearby(150.0f))
+            return false;
+    }
+
+    return true;
+}
+
+Player* RandomPlayerbotMgr::SelectHotspotBot(Player* player)
+{
+    std::vector<Player*> candidates;
+    for (PlayerBotMap::const_iterator itr = playerBots.begin(); itr != playerBots.end(); ++itr)
+    {
+        Player* bot = itr->second;
+        if (IsHotspotCandidate(bot, player))
+            candidates.push_back(bot);
+    }
+
+    if (candidates.empty())
+        return nullptr;
+
+    std::shuffle(candidates.begin(), candidates.end(), RandomEngine::Instance());
+    return candidates.front();
+}
+
+bool RandomPlayerbotMgr::TeleportBotNearPlayer(Player* bot, Player* player)
+{
+    if (!IsHotspotCandidate(bot, player))
+        return false;
+
+    PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot);
+    Map* map = player->GetMap();
+    if (!botAI || !map)
+        return false;
+
+    float radius = static_cast<float>(std::max<uint32>(40, sPlayerbotAIConfig.playerHotspotRadius));
+    float minDistance = std::min(80.0f, radius * 0.65f);
+    float maxDistance = std::max(minDistance + 10.0f, radius);
+    constexpr float TwoPi = 6.28318530718f;
+
+    for (uint32 attempt = 0; attempt < 12; ++attempt)
+    {
+        float angle = frand(0.0f, TwoPi);
+        float distance = frand(minDistance, maxDistance);
+        float x = player->GetPositionX() + std::cos(angle) * distance;
+        float y = player->GetPositionY() + std::sin(angle) * distance;
+        float z = player->GetPositionZ();
+
+        float ground = map->GetHeight(player->GetPhaseMask(), x, y, z + 5.0f);
+        if (ground <= INVALID_HEIGHT)
+            continue;
+
+        z = 0.05f + ground;
+        if (map->IsInWater(player->GetPhaseMask(), x, y, z, bot->GetCollisionHeight()))
+            continue;
+
+        AreaTableEntry const* zone = sAreaTableStore.LookupEntry(map->GetZoneId(player->GetPhaseMask(), x, y, z));
+        AreaTableEntry const* area = sAreaTableStore.LookupEntry(map->GetAreaId(player->GetPhaseMask(), x, y, z));
+        if (!zone || !area)
+            continue;
+
+        WorldLocation loc(player->GetMapId(), x, y, z, angle);
+        if (!botAI->StarterLevelDistanceCheck(bot, loc, true))
+            continue;
+
+        bot->GetMotionMaster()->Clear();
+        botAI->Reset(true);
+        bot->RemoveAurasWithInterruptFlags(AURA_INTERRUPT_FLAG_TELEPORTED | AURA_INTERRUPT_FLAG_CHANGE_MAP);
+        bot->TeleportTo(player->GetMapId(), x, y, z, angle);
+        bot->SendMovementFlagUpdate();
+
+        uint32 botId = bot->GetGUID().GetCounter();
+        uint32 cooldown = std::max<uint32>(60, sPlayerbotAIConfig.playerHotspotCooldown);
+        SetEventValue(botId, "player_hotspot", player->GetGUID().GetCounter(), cooldown, player->GetName());
+        ScheduleTeleport(botId, cooldown);
+
+        LOG_DEBUG("playerbots", "Player hotspot moved bot {} near player {} on map {} zone {} area {}.",
+                  bot->GetName(), player->GetName(), player->GetMapId(), zone->ID, area->ID);
+        return true;
+    }
+
+    return false;
+}
