[Unit]
Description=AzerothCore PlayerBot MCP Tool Server on RT
After=network-online.target mysql.service docker.service
Wants=network-online.target mysql.service

[Service]
Type=simple
User=wuya
Group=wuya
WorkingDirectory=/home/wuya/git/azerothcore-wotlk-git
Environment=PATH=/home/wuya/git/azerothcore-wotlk-git/var/playerbot-mcp-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/home/wuya/git/azerothcore-wotlk-git/env/dist/etc/playerbot-mcp.env
ExecStartPre=/usr/bin/mkdir -p /home/wuya/git/azerothcore-wotlk-git/env/dist/logs
ExecStart=/home/wuya/git/azerothcore-wotlk-git/var/playerbot-mcp-venv/bin/python /home/wuya/git/azerothcore-wotlk-git/tools/playerbot-mcp/server.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=append:/home/wuya/git/azerothcore-wotlk-git/env/dist/logs/playerbot-mcp.log
StandardError=append:/home/wuya/git/azerothcore-wotlk-git/env/dist/logs/playerbot-mcp.log

[Install]
WantedBy=multi-user.target
